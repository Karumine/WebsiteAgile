# Agile Assets Backend API Configuration
# In local development: Leave blank to use Vite Proxy (/api/v1 -> https://api.tunjai.in.th/api/v1)
# In production: Set to public API URL
VITE_API_URL=https://api.tunjai.in.th/api/v1

# Cloudflare Turnstile site key (public). When set, every public form shows a bot check
# and sends `meta.captchaToken`; the backend must verify it with the matching secret key.
VITE_TURNSTILE_SITE_KEY=

# Dev-only offline admin login (put these in .env.development.local, which is gitignored).
# Ignored by production builds.
# VITE_DEV_ADMIN_USER=
# VITE_DEV_ADMIN_PASS=
